# EasyAll configuration.
# Copy this file to ".env" for local development and fill in your own keys.
# NEVER commit a real .env file, and never put a real key in this file.
# On Vercel / Render / Railway, set these in the host's dashboard instead.

# ElevenLabs API key (https://elevenlabs.io/app/developers/api-keys)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Speechify API key (https://platform.speechify.ai — API keys)
SPEECHIFY_API_KEY=your-speechify-api-key

# Optional: monthly Speechify character allowance used for the balance meter.
# Default 500000 (the Speechify API free plan). Speechify has no public
# balance endpoint, so EasyAll counts characters generated through this app.
SPEECHIFY_MONTHLY_CHARACTERS=500000

# Optional: set a shared password to gate the whole site. Leave empty for open access.
# Anyone with the link can spend your voice credits, so set this when sharing publicly.
APP_PASSWORD=

# Optional: where generated clips are stored. Default ./data (or /tmp/easyall-data on Vercel).
DATA_DIR=

# Optional: port for local / traditional hosting. Default 3000.
PORT=3000
